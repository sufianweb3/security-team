{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-auditor.local/schemas/scope.schema.json",
  "title": "Sentinel Auditor assessment scope",
  "type": "object",
  "required": [
    "scope_version",
    "assessment",
    "authorization",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "scope_version": {
      "const": 1
    },
    "assessment": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "type": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_code",
              "website",
              "api_spec",
              "dependency_analysis",
              "documentation",
              "combined"
            ]
          }
        },
        "started_at": {
          "type": "string"
        },
        "config_version": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "authorization": {
      "type": "object",
      "required": [
        "status",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "authorized",
            "unconfirmed",
            "not_authorized"
          ]
        },
        "basis": {
          "enum": [
            "own_code",
            "written_permission",
            "bug_bounty_program",
            "training_lab",
            "public_source_review"
          ]
        },
        "authorized_by": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        },
        "program": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            },
            "policy_url": {
              "type": "string"
            },
            "policy_file": {
              "type": "string"
            },
            "known_issues_file": {
              "type": "string"
            },
            "prohibited_tests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathTarget"
          }
        },
        "api_specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathTarget"
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathTarget"
          }
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "url",
              "commit"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "commit": {
                "type": "string"
              },
              "subdirs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "repository_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_hosts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowed_path_prefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/"
              }
            },
            "seed_urls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allow_plain_http": {
              "type": "boolean"
            },
            "passive_checks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vuln_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_http_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "request_timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 60
        },
        "min_interval_seconds": {
          "type": "number",
          "minimum": 0.5
        },
        "max_tool_seconds": {
          "type": "integer",
          "minimum": 30
        }
      }
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_private_targets": {
          "type": "boolean"
        }
      }
    },
    "business_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "assets"
      ],
      "description": "Organization-specific context used ONLY for business priority. Supplied by the asset owner or copied from the program policy; never inferred by agents.",
      "properties": {
        "source": {
          "enum": [
            "program_policy",
            "owner_provided",
            "unknown"
          ]
        },
        "source_ref": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "program_severity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scale": {
              "enum": [
                "cvss31",
                "bugcrowd_vrt",
                "hackerone",
                "custom"
              ]
            },
            "source_ref": {
              "type": "string"
            },
            "category_ratings": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "out_of_scope_impacts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "match",
              "criticality"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "description": {
                "type": "string"
              },
              "match": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "target_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "path_prefixes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "hosts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "criticality": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "max_severity": {
                "enum": [
                  "informational",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "data_classes": {
                "type": "array",
                "items": {
                  "enum": [
                    "authentication",
                    "credentials",
                    "customer_content",
                    "financial",
                    "funds",
                    "health",
                    "internal",
                    "none",
                    "payment",
                    "pii",
                    "public",
                    "secrets",
                    "telemetry"
                  ]
                }
              },
              "environment": {
                "enum": [
                  "production",
                  "staging",
                  "test",
                  "development",
                  "sandbox",
                  "demo",
                  "unknown"
                ]
              },
              "internet_exposed": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "pathTarget": {
      "type": "object",
      "required": [
        "id",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
